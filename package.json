{
  "name": "things-companion",
  "version": "0.6.0",
  "private": true,
  "description": "An original animated hand companion for getting things done.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:setup": "python -m venv .desktop-env && .desktop-env\\Scripts\\python.exe -m pip install -r requirements-desktop.txt && .desktop-env\\Scripts\\python.exe electron/voice_worker.py --prepare",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
